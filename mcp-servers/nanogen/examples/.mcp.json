{
  "mcpServers": {
    "nanogen": {
      "command": "python3",
      "args": [
        "/absolute/path/to/nanogen/server.py"
      ],
      "env": {
        "GEMINI_API_KEY": "your_gemini_api_key_here",
        "NANOGEN_CACHE_DIR": "/Users/you/.cache/nanogen",
        "NANOGEN_MAX_CONCURRENT": "2",
        "NANOGEN_TIMEOUT": "120"
      }
    }
  }
}
